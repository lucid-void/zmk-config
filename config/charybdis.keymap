#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    /* Trackball listener and input processors (cursor scaling, auto-mouse
       layer 5, scroll on layer 1) live in
       boards/shields/charybdis/charybdis_dongle.overlay, since only the
       dongle (central) has the input listener. */

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
        };

        tl: layer_tap_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            bindings = <&mo>, <&kp>;
        };

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <240>;
            quick-tap-ms = <150>;
            bindings = 
                <&mo>,
                <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
&kp ESC    &kp Q         &kp W        &kp E        &kp R        &kp T      &kp Y    &kp U         &kp I       &kp O        &kp P           &kp BSPC
&kp TAB    &hm LSHFT A   &hm LCTRL S  &hm LGUI D   &hm LALT F   &kp G      &kp H    &hm LALT J    &hm RGUI K  &hm RCTRL L  &hm RSHFT SEMI  &kp APOS
&kp LSHFT  &kp Z         &kp X        &kp C        &kp V        &kp B      &kp N    &kp M         &kp COMMA   &kp DOT      &kp FSLH        &kp RSHFT
                                      &kp LGUI     &tl 1 ESC    &kp SPACE  &kp RET  &tl 2 BSPC
            >;
        };

        Nav {
            display-name = "Num&Nav";
            bindings = <
&none  &kp N1     &kp N2     &kp N3     &kp N4     &kp N5    &kp N6     &kp N7     &kp N8     &kp N9     &kp N0   &trans
&none  &none      &none      &none      &none      &none     &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp DEL  &trans
&none  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &none     &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &none   &trans
                             &trans     &trans     &trans    &trans     &trans
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
&none           &kp EXCL  &kp AT       &kp HASH    &kp DLLR  &kp PRCNT   &kp CARET  &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR  &trans
&none           &bt BT_CLR &bt BT_PRV  &bt BT_NXT  &none     &kp TILDE   &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH  &trans
&studio_unlock  &none     &out OUT_TOG &bootloader &none     &to 3       &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE  &kp GRAVE
                                       &trans      &trans    &trans      &trans     &trans
            >;
        };

        Game {
            display-name = "Game";
            bindings = <
&trans  &trans  &trans  &trans  &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans         &sl 4      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans        &trans      &trans  &trans  &trans  &trans  &trans   &to 0
                        &trans  &trans  &kp LEFT_ALT    &kp RGUI  &trans
            >;
        };

        Game_++ {
            display-name = "Game ++";
            bindings = <
 &kt F5  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp LC(RA(Y))  &kp LC(RA(U))  &kp LC(RA(I))  &kp LC(RA(H))  &kp LC(RA(J))  &kp LC(RA(DEL))
  &to 3         &kp L         &kp O         &kp Y         &kp K         &kp G           &trans         &trans         &trans         &trans         &trans       &kp LA(F4)
&kp F10         &none         &to 0         &none  &kp NUMBER_6  &kp NUMBER_7           &trans         &trans         &trans         &trans         &trans            &to 0
                                            &kp J         &kp I         &kp M           &trans         &trans
            >;
        };

        Mouse {
            display-name = "Mouse";
            bindings = <
   &trans  &trans  &trans     &trans  &trans     &trans    &trans  &trans  &trans  &trans  &trans     &trans
   &trans  &trans  &trans     &trans  &trans     &trans    &trans  &trans  &trans  &trans  &trans     &trans
&mkp MCLK  &trans  &trans     &trans  &trans     &trans    &trans  &trans  &trans  &trans  &trans  &mkp LCLK
                           &mkp LCLK  &trans  &mkp RCLK    &trans  &trans
            >;
        };
    };
};